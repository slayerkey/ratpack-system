{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "imgs/actions/status/icon",
      "Name": "Bridge Status",
      "States": [
        {
          "Image": "imgs/actions/status/key",
          "ShowTitle": true,
          "Title": "Discord\nBridge",
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF"
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Shows PackRat Discord Panel bridge status. Press to authorize or refresh Discord voice.",
      "UserTitleEnabled": true,
      "UUID": "com.packrat.discord-bridge.status"
    }
  ],
  "Author": "PackRat 🐀",
  "Category": "PackRat Discord Bridge",
  "CategoryIcon": "imgs/category/icon",
  "CodePath": "bin/plugin.js",
  "Description": "Free local Discord voice companion for the PackRat Discord Voice Panel on XENEON Edge.",
  "Icon": "imgs/plugin/icon",
  "Name": "PackRat Discord Bridge",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.3"
  },
  "UUID": "com.packrat.discord-bridge",
  "Version": "1.0.0.0"
}
