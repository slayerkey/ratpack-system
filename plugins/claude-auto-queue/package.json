{
  "name": "claude-auto-queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:profiles": "node scripts/build-profiles.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:profiles && rollup -c",
    "test": "node --test tests/*.test.js",
    "watch": "npm run build:profiles && rollup -c -w --watch.onEnd=\"streamdeck restart com.packrat.claude-auto-queue\""
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "~24.1.0",
    "rollup": "^4.0.2",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  }
}
