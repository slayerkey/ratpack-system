{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Auto Queue for Claude Code",
  "Version": "0.1.0.0",
  "Author": "Packrat",
  "Description": "Queue follow-up work for Claude Code from Stream Deck and see when Claude is working, finished, or needs your attention.",
  "Category": "Auto Queue for Claude Code",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "6.9"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "UUID": "com.packrat.claude-auto-queue",
  "Profiles": [
    {
      "Name": "profiles/auto-queue-standard",
      "DeviceType": 0,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/auto-queue-mini",
      "DeviceType": 1,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/auto-queue-xl",
      "DeviceType": 2,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/auto-queue-plus",
      "DeviceType": 7,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "profiles/auto-queue-neo",
      "DeviceType": 9,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    }
  ],
  "Actions": [
    {
      "Name": "Claude Status",
      "UUID": "com.packrat.claude-auto-queue.status",
      "Icon": "imgs/actions/common/icon",
      "Tooltip": "Show the active Claude Code chat state, elapsed turn time and Auto Queue count.",
      "PropertyInspectorPath": "ui/config.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/common/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Queue Prompt",
      "UUID": "com.packrat.claude-auto-queue.queue-prompt",
      "Icon": "imgs/actions/common/icon",
      "Tooltip": "Queue a reusable prompt for the active Claude Code chat without interrupting its current work.",
      "PropertyInspectorPath": "ui/config.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/common/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Next Prompt",
      "UUID": "com.packrat.claude-auto-queue.next-prompt",
      "Icon": "imgs/actions/common/icon",
      "Tooltip": "Show the next queued prompt and total pending count.",
      "PropertyInspectorPath": "ui/config.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/common/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Queue Control",
      "UUID": "com.packrat.claude-auto-queue.queue-control",
      "Icon": "imgs/actions/common/icon",
      "Tooltip": "Remove the next prompt, clear the queue or move the next prompt to the end.",
      "PropertyInspectorPath": "ui/config.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/common/key",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}
