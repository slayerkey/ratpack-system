{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": ".test-build",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false,
    "noEmit": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/gsi/normalize.ts",
    "src/session/**/*.ts",
    "src/render/**/*.ts",
    "tests/**/*.ts"
  ]
}
